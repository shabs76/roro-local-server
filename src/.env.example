# Copy to .env and fill in. Never commit the real .env.

# Database the server uses
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DBNAME=roro_local

# MariaDB container (docker compose): creates the database and its user on the first
# start. MYSQL_DATABASE must equal MYSQL_DBNAME; MYSQL_USER/MYSQL_PASSWORD are the
# same account as MYSQL_USER/MYSQL_PASS above.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=roro_local

# Remote server
REMOTE_SERVER_URL=https://api.walls.co.tz

# Initial user: remote credentials of a user who may read the company's users.
# On every start the server signs in to the remote server as this user and pulls the
# roles, users and reference lists. A fresh installation needs this before anyone
# can log in.
INIT_USER_EMAIL=
INIT_USER_PASSWORD=

# Optional
PORT=4400
LOG_DIR=logs
APP_ENV=production
# Parallel work when this server publishes to the remote server
PUBLISH_ITEM_WORKERS=3
PUBLISH_MEDIA_WORKERS=6
