# Copy to .env and fill in. Never commit the real .env.

# Database the server uses
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DBNAME=roro_local

# With docker compose, the database container is set up from the .env file next to
# docker-compose.yml (see ../.env.example). MYSQL_USER, MYSQL_PASS and MYSQL_DBNAME
# here must match MYSQL_USER, MYSQL_PASSWORD and MYSQL_DATABASE there. Compose sets
# MYSQL_HOST to the database container itself.

# Remote server
REMOTE_SERVER_URL=https://api.walls.co.tz

# Initial user: remote credentials of a user who may read the company's users.
# On every start the server signs in to the remote server as this user and pulls the
# roles, users and reference lists. A fresh installation needs this before anyone
# can log in.
INIT_USER_EMAIL=
INIT_USER_PASSWORD=

# Optional
PORT=4400
LOG_DIR=logs
APP_ENV=production
# Parallel work when this server publishes to the remote server
PUBLISH_ITEM_WORKERS=3
PUBLISH_MEDIA_WORKERS=6
