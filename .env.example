# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real .env.
# Used by the MariaDB and phpMyAdmin containers. The server itself reads src/.env.

# Created on the first start of an empty database volume. Changing these later does
# not change the existing accounts.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=roro_local
# The account the server uses: must equal MYSQL_USER and MYSQL_PASS in src/.env.
MYSQL_USER=roro
MYSQL_PASSWORD=

# Clock of the database and server containers. Use the same zone as the tablets.
TZ=Africa/Dar_es_Salaam
